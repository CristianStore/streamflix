# ===================================================
# STREAMFLIX - VARIABLES DE ENTORNO PARA DESPLIEGUE
# ===================================================

# Puerto asignado dinámicamente por Render (por defecto 3000)
PORT=3000

# Cadena de conexión de MongoDB Atlas (o local mongodb://127.0.0.1:27017/streamflix)
MONGO_URI=mongodb+srv://usuario:password@cluster0.abcde.mongodb.net/streamflix?retryWrites=true&w=majority

# Clave secreta para firma de Tokens JWT de sesión
JWT_SECRET=super_secreto_jwt_streamflix_seguro_2025

# Clave de 32 bytes para cifrado AES-256 de los tickets de reproducción HLS
STREAM_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Clave API oficial de TMDb (The Movie Database) v3
TMDB_API_KEY=tu_clave_api_tmdb_aqui

# URL de la lista pública de canales IPTV en formato M3U
IPTV_SOURCE_URL=https://iptv-org.github.io/iptv/index.m3u

# Expiración de tickets temporales de stream (en segundos, ej. 900 = 15 minutos)
STREAM_TOKEN_EXPIRATION_SECONDS=900

# Plantillas HTTPS de proveedores HLS/embeds que tienes autorización para usar.
# Placeholders: {tmdbId}, {mediaId}, {type}, {season}, {episode}
AUTHORIZED_STREAM_PROVIDERS=https://media.example.com/{type}/{tmdbId}/master.m3u8

# Streams públicos de prueba de transporte HLS. No se consideran fuentes latino
# hasta que el manifiesto anuncie una pista es-MX/es-LAT/es-419/spa.
PUBLIC_TEST_HLS_SOURCES=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8,https://bitdash-a.akamaihd.net/content/sintel/hls/playlist.m3u8,https://demo.unified-streaming.com/k8s/features/stable/video/tears-of-steel/tears-of-steel.ism/.m3u8

# Hosts HTTPS autorizados para POST /api/stream/direct, separados por comas.
AUTHORIZED_HLS_HOSTS=media.example.com
