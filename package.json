{
  "name": "streamflix-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run desktop",
    "desktop": "concurrently \"npm --prefix backend run dev\" \"wait-on http://localhost:3000 && electron . --disable-gpu --disable-gpu-compositing --disable-software-rasterizer\"",
    "electron": "electron . --disable-gpu --disable-gpu-compositing --disable-software-rasterizer",
    "desktop:shortcut": "node scripts/create-desktop-shortcut.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^33.2.0",
    "electron-reload": "^2.0.0-alpha.1",
    "wait-on": "^8.0.0"
  }
}
